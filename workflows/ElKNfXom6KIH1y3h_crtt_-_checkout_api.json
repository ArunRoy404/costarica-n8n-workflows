      {
        "parameters": {
          "jsCode": "const prior = $('Validate Billing Fields').first().json;\nconst countryData = $input.first().json;\nconst states = countryData.states || [];\n\nif (states.length === 0) {\n  return [{ json: { ...prior, error: false } }];\n}\n\nconst userInput = (prior.state || '').trim().toLowerCase();\n\nconst exactCodeMatch = states.find(s => s.code.toLowerCase() === userInput);\nif (exactCodeMatch) {\n  return [{ json: { ...prior, state: exactCodeMatch.code, error: false } }];\n}\n\nconst nameMatch = states.find(s =>\n  s.name.trim().toLowerCase() === userInput ||\n  s.name.trim().toLowerCase().includes(userInput) ||\n  userInput.includes(s.name.trim().toLowerCase())\n);\nif (nameMatch) {\n  return [{ json: { ...prior, state: nameMatch.code, error: false } }];\n}\n\nconst validNames = states.map(s => s.name.trim()).join(', ');\nreturn [{ json: { error: true, message: `\"${prior.state}\" isn't a recognized state/division for ${countryData.name}. Valid options: ${validNames}` } }];"
        },
