      {
        "parameters": {
          "jsCode": "const d = $json;\nconst required = ['first_name','last_name','address_1','city','state','postcode','country','email','phone'];\nconst missing = required.filter(f => !d[f] || String(d[f]).trim() === '');\n\nconst emailOk = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(d.email || '');\nconst countryOk = /^[A-Z]{2}$/.test((d.country || '').trim().toUpperCase());\n\nif (missing.length > 0) {\n  return [{ json: { error: true, message: `Missing required billing info: ${missing.join(', ')}.` } }];\n}\n\nif (!emailOk) {\n  return [{ json: { error: true, message: 'The email address provided is not valid.' } }];\n}\n\nif (!countryOk) {\n  return [{ json: { error: true, message: 'Country must be a valid 2-letter country code (e.g. US, CR, GB).' } }];\n}\n\nreturn [{ json: { ...d, error: false } }];"
