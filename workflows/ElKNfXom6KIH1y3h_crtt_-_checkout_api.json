      {
        "parameters": {
          "jsCode": "const resp = $input.first().json;\nconst prior = $('Check Cart Exists').first().json;\nconst cartToken = resp.headers?.['cart-token'] || resp.headers?.['Cart-Token'];\nconst nonce = resp.headers?.['nonce'] || resp.headers?.['Nonce'];\n\nif (!cartToken || !nonce) {\n  return [{ json: { error: true, message: 'Could not establish a secure checkout session. Please try again.' } }];\n}\n\nreturn [{\n  json: {\n    ...prior,\n    error: false,\n    cart_token: cartToken,\n    nonce: nonce\n  }\n}];"
