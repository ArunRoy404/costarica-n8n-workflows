    {
      "parameters": {
        "jsCode": "const resp = $input.first().json;\nconst prior = $('Resolve State Code').first().json;\n\nif (resp.error) {\n  return [{ json: { error: true, message: resp.error.message || 'Checkout request failed.' } }];\n}\n\nconst body = resp.body;\nconst statusOk = resp.statusCode >= 200 && resp.statusCode < 300;\n\nfunction extractErrorMessage(b) {\n  if (!b) return 'Checkout failed for an unknown reason.';\n  if (b.data?.errors?.billing) return 'Billing address issue: ' + b.data.errors.billing.join(', ');\n  if (b.data?.details) {\n    const messages = Object.values(b.data.details).map(d => d.message).filter(Boolean);\n    if (messages.length) return messages.join(', ');\n  }\n  if (b.message) return b.message;\n  return 'Checkout failed for an unknown reason.';\n}\n\nconst redirectUrl = body?.payment_result?.redirect_url;\n\nif (!statusOk || !redirectUrl) {\n  return [{ json: { error: true, message: extractErrorMessage(body) } }];\n}\n\nreturn [{\n  json: {\n    error: false,\n    order_id: body.order_id,\n    order_number: body.order_number,\n    order_key: body.order_key,\n    payment_status: body.payment_result?.payment_status,\n    redirect_url: redirectUrl,\n    email: prior.email\n  }\n}];"
      },
