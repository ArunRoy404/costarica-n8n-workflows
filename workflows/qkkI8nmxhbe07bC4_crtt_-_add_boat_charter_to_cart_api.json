        "name": "Fetch Charter Detail",
        "onError": "continueRegularOutput"
      },
      {
        "parameters": {
          "jsCode": "// Validates required fields, matches (duration_key × passengers) against rate_table\n// to confirm a valid boat/duration combination and get the correct pickup_time.\n// total_price is hardcoded to 5000 — the backend recalculates the real price/fees\n// regardless of what's submitted here, same as the tour flow.\n\nconst input = $('When Called by Agent').first().json;\nconst detail = $input.first().json;\n\n// Detail lookup failed (bad charter id, wrong service_type, deleted charter, etc.)\nif (!detail || detail.code) {\n  return [{\n    json: {\n      error: true,\n      message: detail?.message || 'Could not load boat charter detail data. Please check the charter ID.'\n    }\n  }];\n}\n\nconst required = ['tour_id', 'email', 'passengers', 'date', 'pickup_location', 'duration'];\nconst missing = required.filter(field => {\n  const val = input[field];\n  return val === undefined || val === null || String(val).trim() === '';\n});\n\nif (missing.length > 0) {\n  return [{ json: { error: true, message: `Missing required field(s): ${missing.join(', ')}` } }];\n}\n\n// ── Passenger + duration validation against rate_table ──────────────────\nconst passengers = Number(input.passengers);\n\nif (!Number.isFinite(passengers) || passengers <= 0) {\n  return [{ json: { error: true, message: 'Passengers must be a valid positive number.' } }];\n}\n\nconst rateTable = Array.isArray(detail.rate_table) ? detail.rate_table : [];\nconst durationKey = String(input.duration).trim();\n\nconst matchingDurationRows = rateTable.filter(r => r.duration_key === durationKey);\n\nif (matchingDurationRows.length === 0) {\n  return [{\n    json: {\n      error: true,\n      message: 'That duration option is not valid for this boat charter. Please choose one of the listed durations.'\n    }\n  }];\n}\n\nconst fitRow = matchingDurationRows.find(\n  r => passengers >= Number(r.min_pax) && passengers <= Number(r.max_pax)\n);\n\nif (!fitRow) {\n  const overallMin = Math.min(...matchingDurationRows.map(r => Number(r.min_pax)));\n  const overallMax = Math.max(...matchingDurationRows.map(r => Number(r.max_pax)));\n  return [{\n    json: {\n      error: true,\n      message: `Passengers must be between ${overallMin} and ${overallMax} for that duration.`\n    }\n  }];\n}\n\n// ── Date validation ───────────────────────────────────────────────────────\nconst dateStr = String(input.date).trim();\nconst dateFormatOk = /^\\d{4}-\\d{2}-\\d{2}$/.test(dateStr);\n\nif (!dateFormatOk) {\n  return [{ json: { error: true, message: 'Date must be in YYYY-MM-DD format.' } }];\n}\n\nconst parsedDate = DateTime.fromISO(dateStr, { zone: 'America/Costa_Rica' });\n\nif (!parsedDate.isValid) {\n  return [{ json: { error: true, message: 'Date is not a valid calendar date.' } }];\n}\n\nconst todayCR = DateTime.now().setZone('America/Costa_Rica').startOf('day');\n\nif (parsedDate.startOf('day') < todayCR) {\n  return [{ json: { error: true, message: 'That date has already passed — please choose a future date.' } }];\n}\n\n// ── Resolved values from the matched rate_table row ──────────────────────\nreturn [{\n  json: {\n    error: false,\n    tour_id: input.tour_id,\n    service_name: detail.title || `Charter ${input.tour_id}`,\n    passengers: passengers,\n    duration_label: fitRow.duration_label,\n    duration_api_value: fitRow.duration_key,\n    total_price: 5000,\n    pickup_time: fitRow.pickup_time || 'Not specified',\n    date: dateStr,\n    pickup_location: input.pickup_location,\n    email: input.email || ''\n  }\n}];"
        },
