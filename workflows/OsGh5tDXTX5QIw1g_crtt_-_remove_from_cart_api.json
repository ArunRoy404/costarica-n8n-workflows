    {
      "parameters": {
        "jsCode": "const resp = $input.first().json;\nconst prior = $('Check Cart Exists').first().json;\nconst cartToken = resp.headers?.['cart-token'] || resp.headers?.['Cart-Token'];\n\nif (!cartToken) {\n  return [{ json: { error: true, message: 'Could not establish a cart session for this email.' } }];\n}\n\nreturn [{\n  json: {\n    error: false,\n    email: prior.email,\n    item_key: prior.item_key,\n    cart_id: prior.cart_id,\n    cart_cookie: prior.cart_cookie,\n    cart_token: cartToken\n  }\n}];"
      },
