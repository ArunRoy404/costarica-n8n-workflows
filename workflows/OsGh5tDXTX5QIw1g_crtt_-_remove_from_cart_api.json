      "name": "Remove Item via Store API"
    },
    {
      "parameters": {
        "jsCode": "const resp = $input.first().json;\nconst prior = $('Extract Cart Token').first().json;\nconst body = resp.body;\nconst statusOk = resp.statusCode >= 200 && resp.statusCode < 300;\nconst stillPresent = Array.isArray(body?.items) && body.items.some(i => i.key === prior.item_key);\n\nif (!statusOk || stillPresent) {\n  return [{ json: { error: true, message: 'Failed to remove the item from the cart.' } }];\n}\n\nreturn [{\n  json: {\n    error: false,\n    email: prior.email,\n    item_key: prior.item_key,\n    remaining_items: body.items?.length ?? 0\n  }\n}];"
      },
