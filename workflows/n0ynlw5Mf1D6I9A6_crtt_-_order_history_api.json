        -608,
        -16
      ],
      "id": "6e630579-2ef6-4c58-9d1e-3d1f7f773fa8",
      "name": "Get Orders by Email",
      "credentials": {
        "wooCommerceApi": {
          "id": "VG4pKpGtyLYBwOzq",
          "name": "CRTT WooCommerce"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const email = $('When Called by Agent').first().json.email;\nconst orders = $input.all().map(item => item.json);\n\nif (!Array.isArray(orders)) {\n  return [{ json: { error: true, message: 'Could not retrieve orders at this time.' } }];\n}\n\nconst emailLower = (email || '').trim().toLowerCase();\nconst matched = orders.filter(o => (o.billing?.email || '').trim().toLowerCase() === emailLower);\n\nif (matched.length === 0) {\n  return [{ json: { error: true, message: 'No orders were found for this email.' } }];\n}\n\nfunction extractMeta(metaArr, key) {\n  const found = (metaArr || []).find(m => m.display_key === key || m.key === key);\n  return found ? found.display_value || found.value : '';\n}\n\nconst cleaned = matched.map(o => {\n  const balanceFee = (o.fee_lines || []).find(f => (f.name || '').toLowerCase().includes('balance to pay on arrival'));\n  const balanceDue = balanceFee ? Math.abs(parseFloat(balanceFee.amount || '0')).toFixed(2) : null;\n\n  const items = (o.line_items || []).map(li => ({\n    service_name: extractMeta(li.meta_data, 'Tour') || li.name,\n    pickup_location: extractMeta(li.meta_data, 'From'),\n    pickup_date: extractMeta(li.meta_data, 'Pickup Date'),\n    pickup_time: extractMeta(li.meta_data, 'Pickup Time'),\n    passengers: extractMeta(li.meta_data, 'Passengers'),\n    quantity: li.quantity,\n    line_total: li.total\n  }));\n\n  return {\n    order_id: o.id,\n    order_number: o.number,\n    status: o.status,\n    date_created: o.date_created,\n    payment_method: o.payment_method_title || o.payment_method,\n    currency: o.currency,\n    deposit_paid_now: o.total,\n    balance_due_on_arrival: balanceDue,\n    needs_payment: o.needs_payment,\n    payment_url: o.payment_url,\n    billing: {\n      name: `${o.billing?.first_name || ''} ${o.billing?.last_name || ''}`.trim(),\n      email: o.billing?.email,\n      phone: o.billing?.phone,\n      address: [o.billing?.address_1, o.billing?.city, o.billing?.state, o.billing?.postcode, o.billing?.country].filter(Boolean).join(', ')\n    },\n    items\n  };\n});\n\nreturn [{\n  json: {\n    error: false,\n    order_count: cleaned.length,\n    orders: cleaned\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -384,
