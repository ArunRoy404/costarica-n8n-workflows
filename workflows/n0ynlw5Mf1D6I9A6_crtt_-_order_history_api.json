      "parameters": {
        "url": "=https://dev.costaricatransfersandtours.com/wp-json/wc/v3/orders",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "wooCommerceApi",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
