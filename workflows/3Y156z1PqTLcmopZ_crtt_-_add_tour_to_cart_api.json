      "name": "Fetch Tour Detail",
      "continueOnFail": true
    },
    {
      "parameters": {
        "jsCode": "// Property + business-rule validation (passengers range, date).\n// total_price is hardcoded to 5000 — the backend recalculates the real\n// price/fees regardless of what's submitted here; this is a safe placeholder.\n\nconst input = $('When Called by Agent').first().json;\nconst detail = $('Fetch Tour Detail').first().json;\n\n// Detail lookup failed (bad tour_id, wrong service_type, deleted tour, etc.)\n// — the WP REST API returns a WP_Error-shaped body with a `code` field\n// instead of a real tour object.\nif (detail.error || detail.code) {\n  return [{\n    json: {\n      error: true,\n      message: detail.error?.message || detail.message || 'Could not load tour detail data. Please check the tour ID.'\n    }\n  }];\n}\n\nconst required = ['tour_id', 'email', 'passengers', 'date', 'pickup_location'];\nconst missing = required.filter(field => {\n  const val = input[field];\n  return val === undefined || val === null || String(val).trim() === '';\n});\n\nif (missing.length > 0) {\n  return [{ json: { error: true, message: `Missing required field(s): ${missing.join(', ')}` } }];\n}\n\n// ── Passenger validation against pricing_summary tiers ──────────────────\nconst passengers = Number(input.passengers);\n\nif (!Number.isFinite(passengers) || passengers <= 0) {\n  return [{ json: { error: true, message: 'Passengers must be a valid positive number.' } }];\n}\n\nconst tiers = Array.isArray(detail.pricing_summary) ? detail.pricing_summary : [];\n\nif (tiers.length > 0) {\n  const fitsAnyTier = tiers.some(t => {\n    const min = Number(t.min_pax);\n    const max = Number(t.max_pax);\n    return passengers >= min && passengers <= max;\n  });\n\n  if (!fitsAnyTier) {\n    const overallMin = Math.min(...tiers.map(t => Number(t.min_pax)));\n    const overallMax = Math.max(...tiers.map(t => Number(t.max_pax)));\n    return [{\n      json: {\n        error: true,\n        message: `Passengers must be between ${overallMin} and ${overallMax} for this tour.`\n      }\n    }];\n  }\n}\n\n// ── Date validation ───────────────────────────────────────────────────────\nconst dateStr = String(input.date).trim();\nconst dateFormatOk = /^\\d{4}-\\d{2}-\\d{2}$/.test(dateStr);\n\nif (!dateFormatOk) {\n  return [{ json: { error: true, message: 'Date must be in YYYY-MM-DD format.' } }];\n}\n\nconst parsedDate = DateTime.fromISO(dateStr, { zone: 'America/Costa_Rica' });\n\nif (!parsedDate.isValid) {\n  return [{ json: { error: true, message: 'Date is not a valid calendar date.' } }];\n}\n\nconst todayCR = DateTime.now().setZone('America/Costa_Rica').startOf('day');\n\nif (parsedDate.startOf('day') < todayCR) {\n  return [{ json: { error: true, message: 'That date has already passed — please choose a future date.' } }];\n}\n\n// ── Pickup time — from API response only ─────────────────────────────────\nconst pickupTime = detail.pickup_time && String(detail.pickup_time).trim() !== ''\n  ? detail.pickup_time\n  : 'Not specified';\n\nreturn [{\n  json: {\n    error: false,\n    tour_id: input.tour_id,\n    service_name: detail.title || detail.name || `Tour ${input.tour_id}`,\n    passengers: passengers,\n    total_price: 5000,\n    pickup_time: pickupTime,\n    date: dateStr,\n    pickup_location: input.pickup_location,\n    email: input.email || ''\n  }\n}];"
      },
