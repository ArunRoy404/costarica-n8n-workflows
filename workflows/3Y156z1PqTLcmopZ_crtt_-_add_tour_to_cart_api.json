        "jsCode": "// Guarantees exactly one item downstream, whether or not Read Cart Row found an existing row.\n// A 0-row match from Google Sheets is NOT an error, so alwaysOutputData does not help here.\n\nconst input = $('Validate + Calculate Price').first().json;\nconst rows = $input.all();\nconst existing = rows.length > 0 ? rows[0].json : null;\n\nreturn [{\n  json: {\n    email: input.email,\n    cart_id: existing?.cart_id || ('cart_' + Date.now() + '_' + Math.random().toString(36).substring(2, 8)),\n    cart_cookie: existing?.cart_cookie || ''\n  }\n}];"
