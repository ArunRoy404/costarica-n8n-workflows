      "parameters": {
        "jsCode": "// Resolve which cart_cookie to persist. Only adopt a fresh set-cookie if it actually carries\n// a session token — a response that only returns woocommerce_cart_hash must NOT overwrite\n// the real session cookie we already have on file.\n\nconst resp = $input.first().json;\nconst normalized = $('Normalize Cart Row').first().json;\n\nconst setCookie = resp.headers?.['set-cookie'] || [];\nconst freshCookie = setCookie.join('; ');\nconst hasSessionToken = /wp_woocommerce_session_/.test(freshCookie);\n\nreturn [{\n  json: {\n    email: normalized.email,\n    cart_id: normalized.cart_id,\n    cart_cookie: hasSessionToken ? freshCookie : normalized.cart_cookie\n  }\n}];"
      },
