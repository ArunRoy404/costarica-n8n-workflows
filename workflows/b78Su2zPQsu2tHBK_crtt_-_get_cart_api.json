      "id": "dcafdfc9-4021-4963-bc75-217417d9994f",
      "name": "Get Cart",
      "continueOnFail": true,
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "parameters": {
        "jsCode": "const inputData = $input.first().json;\n\n// Catch n8n HTTP Request errors (like 403 Forbidden on expired sessions)\nif (inputData.error) {\n  return [{ json: { cart_empty: true, message: 'Your cart session has expired or is invalid. Please start a new order.', items: [] } }];\n}\n\nlet body = inputData;\nif (Array.isArray(body)) body = body[0];\n\n// Catch WooCommerce specific session errors\nif (body.code === 'woocommerce_rest_cart_invalid_session' || body.data?.status >= 400) {\n  return [{ json: { cart_empty: true, message: 'Your cart session has expired. Please start a new order.', items: [] } }];\n}\n\nconst items = body.items || [];\n\nif (items.length === 0) {\n  return [{ json: { cart_empty: true, message: 'The cart is currently empty.', items: [] } }];\n}\n\n// Helper to pull a named field out of WooCommerce's item_data array\nconst getField = (item, label) => {\n  const found = (item.item_data || []).find(f => f.name === label);\n  return found ? found.value : undefined;\n};\n\nconst minorUnit = body.totals?.currency_minor_unit ?? 2;\nconst divisor = Math.pow(10, minorUnit);\nconst toAmount = (raw) => Number(raw || 0) / divisor;\n\nconst summarizedItems = items.map(item => ({\n  key: item.key,\n  service_name: getField(item, 'Tour') || getField(item, 'Boat Charter') || item.name,\n  passengers: getField(item, 'Passengers'),\n  date: getField(item, 'Pickup Date'),\n  pickup_time: getField(item, 'Pickup Time'),\n  pickup_location: getField(item, 'Pickup Location'),\n  duration_label: getField(item, 'Duration'),\n  line_total: toAmount(item.totals?.line_total)\n}));\n\nconst currencySymbol = body.totals?.currency_symbol || '$';\n\n// Pull fee amounts by key rather than by array position\nconst findFee = (key) => (body.fees || []).find(f => f.key === key);\nconst paymentFee = findFee('payment-fee');\nconst balanceFee = findFee('balance-to-pay-on-arrival');\n\nconst subtotal = toAmount(body.totals?.total_items);\nconst salesTax = toAmount(body.totals?.total_tax);\n\n// Provide safe fallbacks if the fees are missing\nconst paymentFeeAmount = paymentFee ? toAmount(paymentFee.totals?.total) : 0;\n// Balance-to-pay-on-arrival is stored as a negative offset — show it as the positive amount owed on arrival.\nconst balanceOnArrival = balanceFee ? Math.abs(toAmount(balanceFee.totals?.total)) : 0;\nconst totalPayNow = toAmount(body.totals?.total_price);\n\nreturn [{\n  json: {\n    cart_empty: false,\n    item_count: summarizedItems.length,\n    currency_symbol: currencySymbol,\n    items: summarizedItems,\n    price_breakdown: {\n      subtotal: subtotal,\n      sales_tax: salesTax,\n      payment_fee: paymentFeeAmount,\n      balance_to_pay_on_arrival: balanceOnArrival,\n      total_pay_now: totalPayNow\n    }\n  }\n}];"
      },
