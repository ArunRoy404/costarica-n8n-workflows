      "id": "232d0aca-b2d4-4812-ad5b-684f7bf20b37",
      "name": "Update Item via Store API",
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "continueOnFail": true
    },
    {
      "parameters": {
        "jsCode": "const resp = $input.first().json;\nconst prior = $('Extract Cart Token').first().json;\nconst body = resp.body || resp;\nconst statusOk = resp.statusCode >= 200 && resp.statusCode < 300;\nconst apiSuccess = body?.success === true;\nconst returnedPassengers = body?.data?.passengers;\nconst countMatches = Number(returnedPassengers) === Number(prior.passenger_count);\n\nif (!statusOk || !apiSuccess || !countMatches) {\n  return [{ json: { error: true, message: 'Failed to update the passenger count for this item.' } }];\n}\n\nreturn [{\n  json: {\n    error: false,\n    message: 'Passenger count updated successfully.',\n    email: prior.email,\n    item_key: prior.item_key,\n    new_passenger_count: returnedPassengers\n  }\n}];"
      },
