    {
      "parameters": {
        "jsCode": "const input = $('When Called by Agent').first().json;\nconst rows = $input.all();\nconst existing = rows.length > 0 ? rows[0].json : null;\n\nconst passCount = parseInt(input.passenger_count, 10);\nif (isNaN(passCount) || passCount <= 0) {\n  return [{ json: { error: true, message: 'passenger_count must be a valid positive number.' } }];\n}\n\nif (!existing || !existing.cart_cookie) {\n  return [{ json: { error: true, message: 'No active cart was found for this email, so there is nothing to update.' } }];\n}\n\nreturn [{\n  json: {\n    error: false,\n    email: input.email,\n    item_key: input.item_key,\n    passenger_count: passCount,\n    cart_id: existing.cart_id,\n    cart_cookie: existing.cart_cookie\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
